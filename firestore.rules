rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /analytics/{analyticId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /interviews/{interviewId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /sessions/{sessionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /activityLog/{activityId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /errorLog/{errorId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /systemLogs/{logId} {
      allow create, read, write: if true;
    }

    match /waitlist/{waitlistId} {
      // Allow anyone to submit early access registrations with verified fields
      allow create: if request.resource.data.email is string 
                    && request.resource.data.email.size() <= 256
                    && request.resource.data.full_name is string
                    && request.resource.data.full_name.size() <= 256
                    && request.resource.data.role is string;
      
      // Restrict read and manage access strictly to the authenticated admin
      allow read, update, delete: if request.auth != null 
                                  && request.auth.token.email == "sushilmadan.yg@gmail.com";
    }

    match /waitlist_duplicates/{dupId} {
      // Allow anyone to create a duplicate tracking log
      allow create: if request.resource.data.email is string
                    && request.resource.data.email.size() <= 256;
                    
      // Restrict read access strictly to the authenticated admin
      allow read, update, delete: if request.auth != null 
                                  && request.auth.token.email == "sushilmadan.yg@gmail.com";
    }
  }
}
